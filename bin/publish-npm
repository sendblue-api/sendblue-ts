#!/usr/bin/env bash

# Never trace credentials, including when called with bash -x.
set +x
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ ${NPM_TOKEN:-} ]]; then
  npm config set '//registry.npmjs.org/:_authToken' "$NPM_TOKEN"
elif [[ ! ${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-} ]]; then
  echo "ERROR: NPM_TOKEN must be set if not running in a Github Action with id-token permission"
  exit 1
fi

SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)"
export SOURCE_DATE_EPOCH
SKIP_SUBPACKAGES=1 yarn build
cd dist

# Keep the publisher and packed archive outside the package being published.
PUBLISH_TOOLS="$(mktemp -d)"
trap 'rm -rf "$PUBLISH_TOOLS"' EXIT
export npm_config_registry='https://registry.npmjs.org'
# This npm version supports OIDC (GitHub supplies short lived credentials).
npm install --ignore-scripts --prefix "$PUBLISH_TOOLS" npm@11.6.2
node "$SCRIPT_DIR/../scripts/verify-npm-publication.mjs" "$PUBLISH_TOOLS/node_modules/.bin/npm"
